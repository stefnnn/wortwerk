{
  "name": "wortwerk",
  "version": "0.2.0",
  "description": "Command line client for wortwerk, translation management with git flow",
  "homepage": "https://wortwerk.li",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefnnn/wortwerk.git",
    "directory": "apps/cli"
  },
  "bin": {
    "wortwerk": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env src/index.ts",
    "build": "tsdown",
    "typecheck": "tsc",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "gettext-parser": "^9.1.1",
    "oxc-parser": "^0.153.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@wortwerk/api": "workspace:*",
    "@wortwerk/formats": "workspace:*",
    "citty": "0.2.2",
    "hono": "^4.13.13",
    "tsdown": "0.23.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
